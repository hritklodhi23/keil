<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!--
  Mini RTOS – Keil MDK Project File
  Target:    STM32F103C8T6 (ARM Cortex-M3, 72 MHz, 64 KB Flash, 20 KB RAM)
  Toolchain: Keil MDK µVision 5 / ARM Compiler 6

  To open: File → Open → select this file in µVision 5
-->
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="project_projx.xsd">

  <SchemaVersion>2.1</SchemaVersion>

  <Header>### uVision Project, (C) Keil Software</Header>

  <Targets>
    <Target>
      <TargetName>MiniRTOS_Debug</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>

      <TargetOption>
        <!-- ── Device ─────────────────────────────────────────────────── -->
        <TargetCommonOption>
          <Device>STM32F103C8</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil.STM32F1xx_DFP.2.4.0</PackID>
          <Cpu>IRAM(0x20000000,0x5000) IROM(0x08000000,0x10000) CPUTYPE("Cortex-M3") CLOCK(12000000) ELITTLE</Cpu>
          <FlashUtilSpec></FlashUtilSpec>
          <StartupFile>"startup_stm32f103x8.s"</StartupFile>
          <FlashDriverDll>UL2CM3(-S0 -C0 -P0 -FD20000000 -FC1000 -FN1 -FF0STM32F10x_64 -FS08000000 -FL010000 -FP0($$Device:STM32F103C8$Flash\STM32F10x_64.FLM))</FlashDriverDll>
          <DeviceId>4214</DeviceId>
          <RegisterFile>$$Device:STM32F103C8$Device\Include\stm32f1xx.h</RegisterFile>
          <MemoryEnv></MemoryEnv>
          <Cmp></Cmp>
          <Asm></Asm>
          <Linker></Linker>
          <OHString></OHString>
          <InfinionOptionDll></InfinionOptionDll>
          <SLE66CMisc></SLE66CMisc>
          <SLE66AMisc></SLE66AMisc>
          <SLE66LinkerMisc></SLE66LinkerMisc>
          <SFDFile>$$Device:STM32F103C8$SVD\STM32F103xx.svd</SFDFile>
          <bCustSvd>0</bCustSvd>
          <UseEnv>0</UseEnv>
          <BinPath></BinPath>
          <IncludePath></IncludePath>
          <LibPath></LibPath>
          <RegisterFilePath></RegisterFilePath>
          <DBRegisterFilePath></DBRegisterFilePath>
          <TargetStatus>
            <Error>0</Error>
            <ExitCodeStop>0</ExitCodeStop>
            <ButtonStop>0</ButtonStop>
            <NotGenerated>0</NotGenerated>
            <InvalidFlash>1</InvalidFlash>
          </TargetStatus>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>MiniRTOS</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateLib>0</CreateLib>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>1</BrowseInformation>
          <ListingPath>.\Listings\</ListingPath>
          <HexFormatSelection>1</HexFormatSelection>
          <Merge32K>0</Merge32K>
          <CreateBatchFile>0</CreateBatchFile>
          <BeforeCompile>
            <RunUserProg1>0</RunUserProg1>
            <RunUserProg2>0</RunUserProg2>
            <UserProg1Name></UserProg1Name>
            <UserProg2Name></UserProg2Name>
            <UserProg1Dos16Mode>0</UserProg1Dos16Mode>
            <UserProg2Dos16Mode>0</UserProg2Dos16Mode>
            <nStopU1X>0</nStopU1X>
            <nStopU2X>0</nStopU2X>
          </BeforeCompile>
          <BeforeMake>
            <RunUserProg1>0</RunUserProg1>
            <RunUserProg2>0</RunUserProg2>
            <UserProg1Name></UserProg1Name>
            <UserProg2Name></UserProg2Name>
            <UserProg1Dos16Mode>0</UserProg1Dos16Mode>
            <UserProg2Dos16Mode>0</UserProg2Dos16Mode>
            <nStopU1X>0</nStopU1X>
            <nStopU2X>0</nStopU2X>
          </BeforeMake>
          <AfterMake>
            <RunUserProg1>0</RunUserProg1>
            <RunUserProg2>0</RunUserProg2>
            <UserProg1Name></UserProg1Name>
            <UserProg2Name></UserProg2Name>
            <UserProg1Dos16Mode>0</UserProg1Dos16Mode>
            <UserProg2Dos16Mode>0</UserProg2Dos16Mode>
            <nStopU1X>0</nStopU1X>
            <nStopU2X>0</nStopU2X>
          </AfterMake>
          <SelectedForBatchBuild>0</SelectedForBatchBuild>
          <SVCSIdString></SVCSIdString>
        </TargetCommonOption>

        <!-- ── Compiler (C/C++) Options ───────────────────────────────── -->
        <CommonProperty>
          <UseCPPCompiler>0</UseCPPCompiler>
          <RVCTCodeConst>0</RVCTCodeConst>
          <RVCTZI>0</RVCTZI>
          <RVCTOtherData>0</RVCTOtherData>
          <ModuleSelection>0</ModuleSelection>
          <IncludeInBuild>1</IncludeInBuild>
          <AlwaysBuild>0</AlwaysBuild>
          <GenerateAssemblyFile>0</GenerateAssemblyFile>
          <AssembleAssemblyFile>0</AssembleAssemblyFile>
          <PublicsOnly>0</PublicsOnly>
          <StopOnExitCode>3</StopOnExitCode>
          <CustomArgument></CustomArgument>
          <IncludeLibraryModules></IncludeLibraryModules>
          <ComprImg>0</ComprImg>
        </CommonProperty>

        <DllOption>
          <SimDllName>SARMCM3.DLL</SimDllName>
          <SimDllArguments> -REMAP -MPU</SimDllArguments>
          <SimDlgDll>DCM.DLL</SimDlgDll>
          <SimDlgDllArguments>-pCM3</SimDlgDllArguments>
          <TargetDllName>SARMCM3.DLL</TargetDllName>
          <TargetDllArguments> -MPU</TargetDllArguments>
          <TargetDlgDll>TCM.DLL</TargetDlgDll>
          <TargetDlgDllArguments>-pCM3</TargetDlgDllArguments>
        </DllOption>

        <DebugOption>
          <OPTHX>
            <HexSelection>1</HexSelection>
            <HexRangeLowAddress>0</HexRangeLowAddress>
            <HexRangeHighAddress>0</HexRangeHighAddress>
            <HexOffset>0</HexOffset>
            <Oh166RecLen>16</Oh166RecLen>
          </OPTHX>
        </DebugOption>

        <Utilities>
          <Flash1>
            <UseTargetDll>1</UseTargetDll>
            <UseExternalTool>0</UseExternalTool>
            <RunIndependent>0</RunIndependent>
            <UpdateFlashBeforeDebugging>1</UpdateFlashBeforeDebugging>
            <Capability>1</Capability>
            <DriverSelection>4096</DriverSelection>
          </Flash1>
          <bMultiFlash>0</bMultiFlash>
        </Utilities>

        <TargetArmAds>
          <!-- ── ARM Compiler 6 (clang-based) ───────────────────────── -->
          <ArmAdsMisc>
            <useUlib>1</useUlib>
            <OptFeed>0</OptFeed>
            <NoZi1>0</NoZi1>
            <NoZi2>0</NoZi2>
            <NoZi3>0</NoZi3>
            <NoZi4>0</NoZi4>
            <NoZi5>0</NoZi5>
            <Ro1>0</Ro1>
            <Ro2>0</Ro2>
            <Ro3>0</Ro3>
            <Ir1>1</Ir1>
            <Ir2>1</Ir2>
            <Ra1>0</Ra1>
            <Ra2>0</Ra2>
            <Ra3>0</Ra3>
            <Im1>1</Im1>
            <Im2>1</Im2>
            <Im3>1</Im3>
            <Im4>1</Im4>
            <Im5>1</Im5>
            <Im6>1</Im6>
            <Im7>1</Im7>
            <Im8>1</Im8>
            <Ra1>0</Ra1>
            <StupSel>8</StupSel>
            <useUlib>1</useUlib>
            <EndSel>0</EndSel>
            <uLtcg>0</uLtcg>
            <nSecure>0</nSecure>
            <RoSelD>3</RoSelD>
            <RwSelD>3</RwSelD>
            <CodeSel>0</CodeSel>
            <OptFeed>0</OptFeed>
          </ArmAdsMisc>
          <Cads>
            <!-- Optimisation: -O1 for debug, -O2 for release -->
            <interw>1</interw>
            <Optim>1</Optim>       <!-- 0=none, 1=-O1, 2=-O2, 3=-O3 -->
            <oTime>0</oTime>
            <SplitLS>0</SplitLS>
            <OneElfS>1</OneElfS>
            <Strict>0</Strict>
            <EnumInt>0</EnumInt>
            <PlainCh>0</PlainCh>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <wLevel>2</wLevel>    <!-- -W2: most warnings enabled -->
            <uThumb>1</uThumb>
            <uSurpInc>0</uSurpInc>
            <uC99>1</uC99>         <!-- C99 standard -->
            <uGnu>0</uGnu>
            <useXO>0</useXO>
            <v6Lang>1</v6Lang>
            <v6LangP>1</v6LangP>
            <vShortEn>1</vShortEn>
            <vShortWch>1</vShortWch>
            <v6Lto>0</v6Lto>
            <v6WtE>0</v6WtE>
            <v6Rtti>0</v6Rtti>
            <!--
              Include paths:
                ..\src\include   — config.h
                ..\src\kernel    — rtos_kernel.h, task_manager.h, etc.
            -->
            <IncludePath>..\src\include;..\src\kernel</IncludePath>
            <ImplicitInclude></ImplicitInclude>
            <Define>STM32F103xB</Define>
            <Undefine></Undefine>
            <UserInc></UserInc>
          </Cads>
          <Aads>
            <interw>1</interw>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <thumb>1</thumb>
            <SplitLS>0</SplitLS>
            <SwStkChk>0</SwStkChk>
            <NoWarn>0</NoWarn>
            <uSurpInc>0</uSurpInc>
            <useXO>0</useXO>
            <uClangAs>0</uClangAs>
            <IncludePath>..\src\include;..\src\kernel</IncludePath>
            <ImplicitInclude></ImplicitInclude>
            <Define></Define>
            <Undefine></Undefine>
            <UserInc></UserInc>
          </Aads>
          <LDads>
            <umfTarg>1</umfTarg>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <noStLib>0</noStLib>
            <RepFail>1</RepFail>
            <useFile>0</useFile>
            <TextAddressRange>0x08000000</TextAddressRange>
            <DataAddressRange>0x20000000</DataAddressRange>
            <pXoBase></pXoBase>
            <ScatterFile></ScatterFile>
            <IncludeLibs></IncludeLibs>
            <IncludeLibsPath></IncludeLibsPath>
            <Misc></Misc>
            <LinkerInputFile></LinkerInputFile>
            <DisabledWarnings></DisabledWarnings>
          </LDads>
        </TargetArmAds>
      </TargetOption>

      <!-- ── Source File Groups ─────────────────────────────────────── -->
      <Groups>

        <!-- RTOS Kernel sources -->
        <Group>
          <GroupName>Kernel</GroupName>
          <Files>
            <File>
              <FileName>rtos_kernel.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\rtos_kernel.c</FilePath>
            </File>
            <File>
              <FileName>task_manager.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\task_manager.c</FilePath>
            </File>
            <File>
              <FileName>scheduler.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\scheduler.c</FilePath>
            </File>
            <File>
              <FileName>context_switch.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\context_switch.c</FilePath>
            </File>
            <File>
              <FileName>synchronization.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\synchronization.c</FilePath>
            </File>
            <File>
              <FileName>systick_handler.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\kernel\systick_handler.c</FilePath>
            </File>
          </Files>
        </Group>

        <!-- Application / example sources -->
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File>
              <FileName>main.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\app\main.c</FilePath>
            </File>
            <File>
              <FileName>led_blink_app.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\app\led_blink_app.c</FilePath>
            </File>
            <File>
              <FileName>sync_example.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\src\app\sync_example.c</FilePath>
            </File>
          </Files>
        </Group>

        <!-- Documentation / include files (shown in IDE for navigation) -->
        <Group>
          <GroupName>Include</GroupName>
          <Files>
            <File>
              <FileName>config.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\include\config.h</FilePath>
            </File>
            <File>
              <FileName>rtos_kernel.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\rtos_kernel.h</FilePath>
            </File>
            <File>
              <FileName>task_manager.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\task_manager.h</FilePath>
            </File>
            <File>
              <FileName>scheduler.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\scheduler.h</FilePath>
            </File>
            <File>
              <FileName>context_switch.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\context_switch.h</FilePath>
            </File>
            <File>
              <FileName>synchronization.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\synchronization.h</FilePath>
            </File>
            <File>
              <FileName>systick_handler.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\src\kernel\systick_handler.h</FilePath>
            </File>
          </Files>
        </Group>

      </Groups>
    </Target>
  </Targets>

</Project>
